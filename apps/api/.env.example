# Copy to .env. Matches the Postgres in docker-compose.yml.
DATABASE_URL=postgres://calo:calo@localhost:5432/calo

# Encrypts Canvas tokens, feed URLs, and Google refresh tokens at rest: 32
# random bytes as hex. Blank here so a key from this file never ends up in
# use. Generate one with:
#   node -e "console.log(crypto.randomBytes(32).toString('hex'))"
ENCRYPTION_KEY=

# The Google Cloud OAuth client that connects Google Calendar (see "Google
# Calendar" in the README). The redirect URI has to match the one registered
# for the client exactly.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:3000/api/google/callback
